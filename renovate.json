{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "gitIgnoredAuthors": [
    "renovate-hash-regen@users.noreply.github.com"
  ],
  "timezone": "US/Eastern",
  "schedule": [
    "at any time"
  ],
  "nix": {
    "enabled": true
  },
  "customDatasources": {
    "stremio": {
      "defaultRegistryUrlTemplate": "https://formulae.brew.sh/api/cask/stremio.json",
      "transformTemplates": [
        "{\"releases\":[{\"version\":version}],\"homepage\":homepage}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Detect nixpkgs/home-manager/nix-darwin release-branch refs in flake.nix and the generated per-input files, for the coordinated group below",
      "managerFilePatterns": [
        "/^modules\/(?:nixpkgs|home-manager|nix-darwin)\\.nix$/",
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "github:(?<repo>NixOS/nixpkgs)/(?<currentValue>(?:nixos|nixpkgs|release)-\\d+\\.\\d+)",
        "github:(?<repo>nix-community/home-manager)/(?<currentValue>release-\\d+\\.\\d+)",
        "github:(?<repo>nix-darwin/nix-darwin)/(?<currentValue>nix-darwin-\\d+\\.\\d+)"
      ],
      "depNameTemplate": "{{{repo}}}",
      "packageNameTemplate": "https://github.com/{{{repo}}}",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "regex:^(?<compatibility>nixos|nixpkgs|release|nix-darwin)-(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "customType": "regex",
      "depNameTemplate": "{{{packageName}}} [{{{packageFileDir}}}/{{{packageFile}}}]",
      "description": "Detect <X>Image/<X>Version/<X>Digest triples in modules/homelab/apps/**, shared by every container pin (postgres, pgvector, redis, valkey, app images, ...)",
      "managerFilePatterns": [
        "/^modules\/homelab\/apps\/.*\\.nix$/"
      ],
      "matchStrings": [
        "[A-Za-z][A-Za-z0-9]*Image\\s*=\\s*\"(?<packageName>[^\"]+)\";\\s+[A-Za-z][A-Za-z0-9]*Version\\s*=\\s*\"(?<currentValue>[^\"]+)\";\\s+[A-Za-z][A-Za-z0-9]*Digest\\s*=\\s*\"(?<currentDigest>sha256:[a-f0-9]{64})\";"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "depTypeTemplate": "nix-package",
      "description": "Detect datasource/packageName/version triples used to pin arbitrary Nix package sources (requires hash regen on update, see packageRule below)",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "datasource\\s*=\\s*\"(?<datasource>[^\"]+)\";(?:\\s+extractVersion\\s*=\\s*\"(?<extractVersion>[^\"]+)\";)?\\s+packageName\\s*=\\s*\"(?<packageName>[^\"]+)\";\\s+version\\s*=\\s*\"(?<currentValue>[^\"]+)\";(?:\\s+versioning\\s*=\\s*\"(?<versioning>[^\"]+)\";)?"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": false,
    "automerge": true,
    "branchTopic": "update-lockfiles",
    "commitMessageAction": "update lockfiles",
    "schedule": [
      "before 6am on Friday"
    ]
  },
  "packageRules": [
    {
      "description": "Disable the built-in nix manager for the nixpkgs input since release-branch tracking happens via the custom regex manager below instead",
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "https://github.com/NixOS/nixpkgs"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Bump nixpkgs/home-manager/nix-darwin release branches together",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "https://github.com/NixOS/nixpkgs",
        "https://github.com/nix-community/home-manager",
        "https://github.com/nix-darwin/nix-darwin"
      ],
      "groupName": "Nix release branches",
      "minimumGroupSize": 6,
      "dependencyDashboardApproval": true,
      "schedule": [
        "before 6am on Saturday"
      ]
    },
    {
      "description": "Batch versioned Nix package source bumps weekly and don't merge until the renovate-hashes CI workflow pushes regenerated hashes",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepTypes": [
        "nix-package"
      ],
      "automerge": false,
      "prBodyNotes": [
        "<!-- nix-source-hash-update -->"
      ],
      "schedule": [
        "before 6am on Saturday"
      ]
    },
    {
      "description": "Parse pgvector tags as <pgvector version>-pg<postgres major> so pgvector releases (e.g. 0.8.7->0.8.8) register as patch/minor, while a Postgres major change (pg17->pg18) still registers as major",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "docker.io/pgvector/pgvector"
      ],
      "versioning": "regex:^\\d+\\.(?<minor>\\d+)\\.(?<patch>\\d+)-pg(?<major>\\d+)$"
    },
    {
      "description": "Tag homelab container PRs with a marker so the CI workflow can skip flake validation for pure image-metadata changes",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "modules/homelab/apps/**"
      ],
      "prBodyNotes": [
        "<!-- homelab-container-update -->"
      ]
    },
    {
      "description": "Give docker.io (not ghcr.io/lscr.io as they don't provide release timestamps) homelab major bumps a 7-day cooldown",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^docker\\.io\\//"
      ],
      "matchFileNames": [
        "modules/homelab/apps/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Automerge homelab container patch/minor bumps",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "modules/homelab/apps/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Require explicit Dependency Dashboard approval for container major bumps",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "modules/homelab/apps/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Skip container updates for apps that aren't deployed",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "modules/homelab/apps/adventurelog.nix"
      ],
      "enabled": false
    }
  ]
}
